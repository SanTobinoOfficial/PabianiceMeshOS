CONFIG_IDF_TARGET="esp32s3"

# przyszła crypto (libsignal) + routing lubią głębsze wywołania niż domyślny stos,
# lepiej ustawić z góry niż łapać stack overflow w nocy
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y

# BLE (NimBLE) dla components/ble - most do telefonu bez internetu, patrz jego README
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# klucze bondingu (parowania) w NVS, zeby telefon nie musial parowac sie na nowo
# po kazdym restarcie wezla
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# kilka telefonow moze korzystac z tego samego wezla naraz - patrz
# BLE_MAX_SUBSCRIBERS w components/ble/ble_bridge.c, te dwie wartosci maja sie zgadzac
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
